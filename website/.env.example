# CodeForge website configuration.
# Every variable is optional: the site builds and runs with none of them set.
# Copy this file to .env.local for local development (never commit .env.local).
# On Vercel, set these in Project Settings -> Environment Variables
# (or with `vercel env add NAME production`).
# None of these values are secrets.

# Public URL of the site, used for canonical links, sitemap and social cards.
# On Vercel this falls back to the production domain automatically.
# Example: https://codeforge.example.com
NEXT_PUBLIC_SITE_URL=

# GitHub repository that hosts CodeForge releases, as owner/name.
# When set, the download page links to
#   https://github.com/<owner>/<name>/releases/download/v<version>/<installer>
# and only shows the Download button once that file really exists.
# Example: your-github-user/codeforge
CODEFORGE_GITHUB_REPO=

# Optional: a direct https:// URL to the Windows installer, overriding the
# GitHub URL above (for example if you host installers elsewhere).
CODEFORGE_DOWNLOAD_URL_WINDOWS=

# Optional: an email address shown on the Support page.
CODEFORGE_SUPPORT_EMAIL=
