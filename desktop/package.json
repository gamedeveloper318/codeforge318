{
  "name": "codeforge-desktop",
  "productName": "CodeForge",
  "version": "0.3.0",
  "description": "CodeForge — a desktop code editor. Your Code. Your Workspace. Your Power.",
  "author": "CodeForge",
  "private": true,
  "main": "out/main/index.js",
  "scripts": {
    "dev": "node scripts/run-clean.mjs electron-vite dev",
    "build": "electron-vite build",
    "start": "node scripts/run-clean.mjs electron-vite preview",
    "typecheck": "tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.web.json && tsc -p tsconfig.test.json",
    "lint": "eslint .",
    "test": "vitest run",
    "test:e2e": "npm run build && playwright test",
    "test:e2e:packaged": "cross-env CODEFORGE_E2E_EXECUTABLE=release/win-unpacked/CodeForge.exe playwright test",
    "icons": "node scripts/build-icons.mjs",
    "package:win": "npm run build && electron-builder --win nsis --x64 --publish never && node scripts/write-release-manifest.mjs",
    "release:win": "node scripts/release.mjs"
  },
  "dependencies": {
    "@lydell/node-pty": "1.2.0-beta.18",
    "electron-updater": "^6.8.11",
    "pyright": "^1.1.414"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.0",
    "@playwright/test": "^1.64.1",
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/xterm": "^6.0.0",
    "cross-env": "^10.0.0",
    "dompurify": "^3.4.17",
    "electron": "^45.1.0",
    "electron-builder": "^26.18.0",
    "electron-vite": "^6.0.0",
    "eslint": "^10.13.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.0.0",
    "lucide-react": "^1.63.0",
    "monaco-editor": "^0.57.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "sharp": "^0.35.5",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.50.0",
    "vite": "^8.3.5",
    "vitest": "^5.0.5",
    "zod": "^4.6.7",
    "zustand": "^5.0.16"
  },
  "overrides": {
    "dompurify": "^3.4.17"
  }
}
